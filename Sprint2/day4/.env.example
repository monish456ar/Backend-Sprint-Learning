# PostgreSQL Database Configuration
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=film_review
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database Connection URL (used by SQLAlchemy & asyncpg)
DATABASE_URL=postgresql+asyncpg://dev_user:your_secure_password_here@localhost:5432/film_review

# Application & Security Settings
TOKEN_SECRET_KEY=your_token_secret_key_here
TOKEN_EXPIRE_MINUTES=30
ALLOWED_CORS_ORIGINS=http://localhost:3000
API_VERSION=v1

# Redis Configuration & Cache TTL
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
FILM_CACHE_TTL_SECONDS=60
